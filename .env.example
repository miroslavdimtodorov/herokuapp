# Copy this file to .env and fill in the values. .env is ignored by git.
# Every value is optional: when it is missing, the default from the code is used.

# Site under test
BASE_URL=https://the-internet.herokuapp.com

# Valid credentials for /login
# (LOGIN_USERNAME, not USERNAME: Windows already sets USERNAME to your Windows user)
LOGIN_USERNAME=tomsmith
LOGIN_PASSWORD=SuperSecretPassword!
